# Leaping — Bearer from POST /v1/login (expires ~15 min)

LEAPING_API_BASE_URL=https://api.leaping.ai/v1
LEAPING_AGENT_ID=

# RECOMMENDED: username/password — tool logs in and auto-refreshes on 401
LEAPING_API_USERNAME=
LEAPING_API_PASSWORD=
# LEAPING_API_CLIENT_ID=
# LEAPING_API_CLIENT_SECRET=

# Optional one-off: pasted token (expires; no auto-refresh unless username/password also set)
# LEAPING_ACCESS_TOKEN=

# OpenAI — for executive summary (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
